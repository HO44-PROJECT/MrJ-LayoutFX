        "c": "t-stop"
      },
      {
        "v": 300,
        "l": "SLOW",
        "c": "t-slow"
      },
      {
        "v": 600,
        "l": "MID",
        "c": "t-go"
      },
      {
        "v": 1000,
        "l": "FAST",
        "c": "t-flash"
      },
      {
        "v": "REV",
