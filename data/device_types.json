      {
        "v": 0,
        "l": "OFF",
        "c": "t-off"
      },
      {
        "v": 1,
        "l": "HP0",
        "c": "t-stop"
      },
      {
        "v": 2,
        "l": "HP1",
        "c": "t-go"
      },
      {
        "v": 3,
        "l": "HP2",
        "c": "t-slow"
      }
    ],
    "wire_aspects": [
      { "l": "red", "c": "#e74c3c" },
      { "l": "green", "c": "#27ae60" },
      { "l": "amber", "c": "#e67e22" }
    ]
  },
