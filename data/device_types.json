      {
        "v": 0,
        "l": "OFF",
        "c": "t-off"
      },
      {
        "v": 1,
        "l": "HP00",
        "c": "t-stop"
      },
      {
        "v": 2,
        "l": "HP1",
        "c": "t-go"
      },
      {
        "v": 3,
        "l": "HP2",
        "c": "t-slow"
      },
      {
        "v": 4,
        "l": "HP0+Sh1",
        "c": "t-sh1"
      }
    ],
    "wire_aspects": [
      { "l": "amber", "c": "#e67e22" },
      { "l": "red_left", "c": "#c0392b" },
      { "l": "red_right", "c": "#e74c3c" },
      { "l": "two_white_green", "c": "#27ae60" }
