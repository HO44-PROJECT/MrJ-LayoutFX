  "MrJDBBlocSignal": {
    "category": "signal",
    "wires": 2,
    "ctor_style": "multi_pin",
    "pin_count_const": "MrJDBBlocSignalState_PIN_COUNT",
    "states": [
      {
        "v": 0,
        "l": "OFF",
        "c": "t-off"
      },
      {
        "v": 1,
        "l": "HP0",
        "c": "t-stop"
      },
      {
        "v": 2,
        "l": "HP1",
        "c": "t-go"
      }
    ],
    "wire_aspects": [
      { "l": "red", "c": "#e74c3c" },
      { "l": "green", "c": "#27ae60" }
    ]
  },
  "MrJDBEntrySignal": {
    "category": "signal",
    "wires": 3,
