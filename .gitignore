.pio
.vscode

# Personal WiFi credentials (compile-time path, no longer the recommended
# flow — see doc/user/wifi-provisioning.md — but still supported).
configurations/auth/wifi.h

# Built firmware binaries (.bin/.elf/.map), copied here per-env by
# scripts/copy_to_dist.py after each build.
dist/

# All generated headers live here — regenerated on every build by
# tools/build_webui.py (webui_html.h), build_embedded_data.py (embedded_*.h) and
# gen_build_info.py (build_info.h). Source of truth: src/web/*, data/*.json.
include/generated/

# Generated by tools/gen_config_validator.py from schemas/config.schema.json
# (Ajv standalone codegen). Source of truth: schemas/config.schema.json.
src/web/generated/

# Node build-time tooling (tools/gen_config_validator.py, ajv) — dev-only,
# never shipped in firmware. Reinstalled automatically on first build
# (see gen_config_validator.py) or manually via `npm install` in tools/.
tools/node_modules/
tools/package-lock.json
tools/._ajv_standalone_tmp_*.cjs

# Python bytecode (tools/ scripts)
__pycache__/
*.pyc
tests

# Investigation post-mortems: personal debugging notes, not shipped project
# documentation — kept locally only.
doc/contributing/troubleshooting/